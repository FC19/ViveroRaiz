        notas: "Ideal para estantes altos o macetas colgantes. Regar cuando la capa superior esté seca."
    }
];

const RepositorioPlantas = {
    obtenerTodas() {
        const guardado = localStorage.getItem(STORAGE_PLANTAS);
        if (!guardado) {
            const iniciales = PLANTAS_INICIALES.map(dato => Planta.fromLiteral(dato));
            this.guardarTodas(iniciales);
            return iniciales;
        }
        try {
            const literales = JSON.parse(guardado);
            return literales.map(dato => Planta.fromLiteral(dato));
        } catch {
            const iniciales = PLANTAS_INICIALES.map(dato => Planta.fromLiteral(dato));
            this.guardarTodas(iniciales);
            return iniciales;
        }
    },

    guardarTodas(plantas) {
        const literales = plantas.map(planta => planta.toLiteral());
        localStorage.setItem(STORAGE_PLANTAS, JSON.stringify(literales));
    },

    obtenerPorId(id) {
        const idNum = Number(id);
        return this.obtenerTodas().find(planta => planta.id === idNum) || null;
    },

    crear(datos) {
        const plantas = this.obtenerTodas();
        const maxId = plantas.reduce((max, p) => Math.max(max, p.id), 0);
        const nueva = new Planta({ ...datos, id: maxId + 1 });
        plantas.push(nueva);
        this.guardarTodas(plantas);
        return nueva;
    },

    actualizar(id, datos) {
        const idNum = Number(id);
        const plantas = this.obtenerTodas();
        const indice = plantas.findIndex(p => p.id === idNum);
        if (indice === -1) return null;

        const actualizada = new Planta({ ...datos, id: idNum });
        plantas[indice] = actualizada;
        this.guardarTodas(plantas);
        return actualizada;
    },

    eliminar(id) {
        const idNum = Number(id);
        const plantas = this.obtenerTodas();
        const restantes = plantas.filter(p => p.id !== idNum);
        if (restantes.length === plantas.length) return false;
        this.guardarTodas(restantes);
        return true;
    },

    obtenerResumen() {
        const plantas = this.obtenerTodas();
        return {
            totalEspecies: plantas.length,
            unidadesTotales: plantas.reduce((total, p) => total + p.stock, 0),
            stockBajo: plantas.filter(p => p.stock <= 5).length
        };
    }
};